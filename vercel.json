{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    },
    {
      "source": "/(styles.css|app.js|og-image.jpg|icon.svg|favicon.ico|favicon-16.png|favicon-32.png|apple-touch-icon.png|brand-icon-96.png|brand-icon-192.png|brand-icon-512.png)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(og-image-v2.jpg|og-image-v3.jpg|img/brand/(.*)|img/lubbes-family.webp|img/lubbes-family-720.webp|img/lubbes-family-1200.webp)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
